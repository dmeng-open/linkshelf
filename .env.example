DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkshelf
# Sign-in allows 5 failed attempts per IP every 15 minutes. Still use a long random password, for example from `openssl rand -base64 24`.
LINKSHELF_PASSWORD=
# At least 32 characters, for example from `openssl rand -base64 48`. Changing it signs everyone out.
SESSION_SECRET=
# Connections each server instance may hold. Keep it small on serverless hosts, where many instances share one database.
DATABASE_POOL_MAX=5
# Seconds to wait for a database connection before a request fails.
DATABASE_CONNECT_TIMEOUT_S=10
